{
  "name": "wesl",
  "version": "0.7.31",
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "repository": "github:webgpu-tools/wesl-js",
  "scripts": {
    "build": "tsdown",
    "build:docs": "typedoc --plugin typedoc-theme-hierarchy --entryPoints ./src/index.ts --entryPointStrategy expand --out ./docs",
    "build:size": "./scripts/size-check.ts",
    "deploy:docsite": "run-s build:docs pages:deploy",
    "dump:cts:cases": "./scripts/dump-cts-cases.ts",
    "dump:cts:shaders": "./scripts/dump-cts-shaders.ts",
    "pages:deploy": "pnpx wrangler pages deploy --project-name wesl-js docs",
    "prepublishOnly": "run-s build",
    "test": "vitest --hideSkippedTests",
    "test:cts": "./scripts/test-cts.ts",
    "test:cts:full": "./scripts/test-cts.ts --full",
    "test:cts:offline": "vitest run CtsConstEval CtsValidation",
    "test:once": "vitest run",
    "typecheck": "tsgo"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./core": {
        "types": "./dist/core.d.ts",
        "import": "./dist/core.js"
      },
      "./bundle-decl": {
        "types": "./dist/weslBundleDeclUrl.d.ts",
        "import": "./dist/weslBundleDeclUrl.js"
      }
    },
    "main": "dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./core": {
      "import": "./src/core.ts"
    },
    "./bundle-decl": {
      "import": "./src/weslBundleDeclUrl.ts"
    },
    "./test-util": {
      "import": "./src/test-util.ts"
    }
  },
  "types": "dist/index.d.ts",
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "multi_pkg": "workspace:x",
    "terser": "^5.43.1",
    "typedoc": "^0.28.7",
    "typedoc-theme-hierarchy": "^6.0.0"
  },
  "license": "MIT",
  "keywords": [
    "webgpu",
    "wesl",
    "wgsl"
  ]
}
